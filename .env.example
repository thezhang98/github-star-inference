# GitHub Personal Access Token (classic or fine-grained) with read access.
# Only the `public_repo`/`repo` read scope is needed to list your stars.
GITHUB_TOKEN=

# M2 (LLM tagging) — OpenAI-compatible endpoint. Defaults target DeepSeek.
# Get a DeepSeek key at https://platform.deepseek.com/ (or point at any
# OpenAI-compatible server: OpenAI, a local vLLM/Ollama gateway, etc.).
LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com   # default
# LLM_MODEL=deepseek-chat                 # default

# Days before a tagged repo is re-tagged on `retag_stale` runs (default 90).
# TAG_TTL_DAYS=90
# README truncation limit, chars, before storing / sending to the LLM.
# README_MAX_CHARS=4000
# Optional comma-separated focus areas; if set, nudges category convergence.
# USER_FOCUS_AREAS=
